# ==============================================================================
# Avyakta Backend Environment Configuration
# ==============================================================================

# Application
APP_ENV=development
DEBUG=true
SECRET_KEY=change-this-in-production-to-a-very-secure-random-string-at-least-32-chars
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Database
# Default: SQLite for immediate local dev and test runs:
# DATABASE_URL=sqlite+aiosqlite:///./data/avyakta.db
# Neon PostgreSQL / Cloud PostgreSQL:
# App connection (pooled for application concurrency):
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Direct connection (used by Alembic for non-pooled schema migrations):
DIRECT_DATABASE_URL="postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Session Cookie Settings
SESSION_COOKIE_NAME=avyakta_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_EXPIRE_DAYS=14

# Email Delivery
# In development, leave blank or set to 'file' to log emails to backend/data/emails/
EMAIL_BACKEND=file
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
EMAIL_FROM=Avyakta <no-reply@avyakta.app>

# Security Rate Limiting
RATE_LIMIT_LOGIN_ATTEMPTS=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_RESET_ATTEMPTS=3
RATE_LIMIT_RESET_WINDOW_MINUTES=60
RATE_LIMIT_SIGNUP_ATTEMPTS=5
RATE_LIMIT_SIGNUP_WINDOW_MINUTES=60
